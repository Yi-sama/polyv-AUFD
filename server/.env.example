HOST=127.0.0.1
PORT=4317
# All management requires an owner session, including loopback requests.
READ_ONLY=false
# ADMIN_TOKEN from v1 is no longer an authentication mechanism.
# Required for a public host. HTTPS origin only, no trailing path.
PUBLIC_ORIGIN=
# Optional additional exact frontend origins, separated by commas.
ALLOWED_ORIGINS=
# Obtain these from the account owner. Never put them in VITE_* variables.
POLYV_VOD_USER_ID=
POLYV_VOD_SECRET_KEY=
# Optional external .env file, passed via the process environment:
# POLYV_ENV_FILE=C:\absolute\path\to\.env
POLYV_TEST_VID=
